logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# TypeScript incremental compilation
*.tsbuildinfo

# Editors
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS files
.DS_Store
*.pem

# Expo / React Native
.expo/
expo-env.d.ts

# Test artifacts
__snapshots__/

