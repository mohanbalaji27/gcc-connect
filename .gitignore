# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.production
.env.*.local
# .env.example is safe to commit (no real values)

