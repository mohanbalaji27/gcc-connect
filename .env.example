# ============================================================
# GCC CONNECT — Environment Variables Template
# ============================================================
# COPY this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
# Use GitHub Secrets / cloud secrets manager in production.
# ============================================================

# ----- Server -----
NODE_ENV=development
PORT=4000
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ----- JWT / Session -----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES_HEX

# ----- Database -----
# Leave blank to use in-memory pg-mem (development only)
DATABASE_URL=
# For production PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/gcc_connect

# ----- OTP / Email -----
# OTPs are printed to console in dev mode when SMTP is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gccconnect.local

# ----- OAuth / SSO (Optional) -----
# Microsoft Entra ID / Azure AD
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_BOOKING=30
RATE_LIMIT_MAX_GENERAL=200

# ----- Frontend (Vite) -----
# Must be prefixed with VITE_ to be exposed to the browser
VITE_API_BASE_URL=http://localhost:4000/api
# Set to "true" only in local dev demo mode — never in production
VITE_DEMO_MODE=true
